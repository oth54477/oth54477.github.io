{
  "$schema": "https://oh-my-design.kr/schema/design-system-graph-v2.schema.json",
  "components_states": {
    "components": [
      {
        "anatomy": [
          "수치",
          "단위",
          "라벨"
        ],
        "id": "hero-metric",
        "interaction": {
          "kind": "non-interactive",
          "reason": "표시 전용 수치 블록으로 클릭·포커스 대상이 아니다"
        },
        "semantics": "히어로 상단의 대표 성과 네 건. 페이지에서 가장 굵은 요소이며 의도된 데이터 앵커다",
        "states": [
          "default"
        ],
        "token_refs": [
          "font.mono",
          "color.text",
          "color.faint"
        ]
      },
      {
        "anatomy": [
          "canvas",
          "Host 클러스터",
          "게이트웨이 노드",
          "경계면 점선",
          "Remote 클러스터 3",
          "HOST/REMOTES 라벨"
        ],
        "id": "federation-field",
        "interaction": {
          "kind": "non-interactive",
          "reason": "aria-hidden이며 pointer-events가 없다. 포인터 위치를 읽기만 하고 입력을 받지 않는다"
        },
        "semantics": "히어로 배경에 Host ↔ Remote 런타임 연합 구조를 2D 캔버스 원근 투영으로 그린다. 본문 텍스트 하단 기준으로 띠를 잡고, 띠가 100px 미만이거나 뷰포트가 640px 미만이면 그리지 않는다",
        "states": [
          "default",
          "pointer-tracking",
          "auto-rotate",
          "offscreen-paused",
          "reduced-motion-static",
          "hidden-narrow"
        ],
        "token_refs": [
          "color.accent",
          "color.muted"
        ]
      },
      {
        "anatomy": [
          "라벨"
        ],
        "id": "tag-chip",
        "interaction": {
          "kind": "non-interactive",
          "reason": "링크나 필터가 아닌 정적 라벨이다"
        },
        "semantics": "기술 스택 항목 표시",
        "states": [
          "default"
        ],
        "token_refs": [
          "font.mono",
          "color.surface",
          "color.line",
          "color.muted",
          "radius.chip"
        ]
      },
      {
        "anatomy": [
          "라벨"
        ],
        "id": "case-link",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "not-applicable",
              "reason": "정적 문서의 외부 링크로 비활성 상태가 존재하지 않는다"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "클라이언트에서 처리하는 실패 경로가 없다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "비동기 요청 없이 문서 이동만 한다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "완료를 보고할 트랜잭션이 없다"
            }
          }
        },
        "semantics": "케이스의 외부 근거로 나가는 링크 칩",
        "states": [
          "default",
          "hover",
          "focus-visible"
        ],
        "token_refs": [
          "font.mono",
          "color.surface",
          "color.line",
          "color.muted",
          "color.accent",
          "radius.chip"
        ],
        "variants": [
          "PR",
          "Issue",
          "저장소"
        ]
      },
      {
        "anatomy": [
          "텍스트",
          "하단 경계선"
        ],
        "id": "inline-link",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "not-applicable",
              "reason": "정적 문서의 링크로 비활성 상태가 존재하지 않는다"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "클라이언트에서 처리하는 실패 경로가 없다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "비동기 요청 없이 문서 이동만 한다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "완료를 보고할 트랜잭션이 없다"
            }
          }
        },
        "semantics": "본문 안 링크. 앰버 글자색과 반투명 앰버 밑줄로 어포던스를 준다",
        "states": [
          "default",
          "hover",
          "focus-visible"
        ],
        "token_refs": [
          "color.accent",
          "radius.focus"
        ]
      },
      {
        "anatomy": [
          "+/− 마커",
          "요약 문구",
          "본문"
        ],
        "id": "disclosure",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "not-applicable",
              "reason": "항상 펼칠 수 있는 정적 콘텐츠다"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "실패할 수 있는 동작이 없다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "내용이 문서에 이미 포함되어 지연 로드가 없다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "완료를 보고할 트랜잭션이 없다"
            }
          }
        },
        "semantics": "케이스의 상세 근거를 감싸는 details/summary. 뷰포트에 들어오면 주변광 하이라이트로 존재를 알리고, 인쇄 시 자동으로 펼쳐진다",
        "states": [
          "default",
          "collapsed",
          "expanded",
          "hover",
          "focus-visible",
          "in-view"
        ],
        "token_refs": [
          "font.mono",
          "color.muted",
          "color.accent",
          "color.faint"
        ]
      },
      {
        "anatomy": [
          "라벨",
          "값"
        ],
        "id": "contact-link",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "not-applicable",
              "reason": "정적 문서의 링크로 비활성 상태가 존재하지 않는다"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "클라이언트에서 처리하는 실패 경로가 없다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "비동기 요청 없이 문서 이동만 한다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "완료를 보고할 트랜잭션이 없다"
            }
          }
        },
        "semantics": "GitHub과 이메일로 나가는 연락처 링크. 클릭 타깃 확보를 위해 상하 패딩을 준다",
        "states": [
          "default",
          "hover",
          "focus-visible"
        ],
        "token_refs": [
          "color.accent",
          "color.text",
          "radius.focus"
        ]
      }
    ],
    "rules": [
      "모든 포커스 가능한 요소는 :focus-visible에서 2px 앰버 아웃라인과 3px 오프셋을 받는다",
      "상호작용 상태는 색과 경계선으로만 표현한다. 그림자나 크기 변화를 쓰지 않는다",
      "이 페이지는 폼과 비동기 요청이 없으므로 disabled/loading/error/success 상태를 정의하지 않는다"
    ]
  },
  "content_locales": {
    "locales": [
      {
        "locale": "ko",
        "rules": [
          "html lang=\"ko\"이며 본문에 word-break: keep-all을 적용해 어절 단위로 끊는다",
          "기술 용어와 제품명은 번역하지 않고 원문으로 둔다",
          "수치는 tabular-nums로 세로 정렬을 맞춘다"
        ],
        "status": "supported"
      }
    ],
    "terminology": {
      "Host": "연합 구조에서 원격 모듈을 소비하는 쪽. 한국어 문장에서도 Host로 표기한다",
      "Remote": "연합 구조에서 모듈을 노출하는 쪽. 한국어 문장에서도 Remote로 표기한다",
      "자세히": "케이스의 상세 근거를 여는 토글 라벨. '더보기'나 '펼치기'로 바꾸지 않는다"
    },
    "voice": [
      "단정형 서술체. 수치를 문장 앞에 둔다",
      "성과와 함께 철회·보류한 판단도 같은 비중으로 적는다",
      "과장 표현과 형용사 대신 측정 조건과 단위를 쓴다",
      "자신의 오진을 감추지 않고 정정 과정을 남긴다"
    ]
  },
  "experience": {
    "avoid": [
      "라이트/다크 테마 토글",
      "그림자 기반 입체 표현",
      "굵기로 만드는 위계",
      "수치가 없는 서술 문장에 거는 강조",
      "빌드 스텝이나 번들러를 요구하는 의존성 추가"
    ],
    "design_direction": [
      "다크 단일 테마에 앰버 악센트 하나. 테마 토글을 두지 않는다",
      "위계는 크기가 만든다. 굵기로 소리치지 않는다",
      "앰버는 측정값과 상호작용 상태에만 배급한다",
      "그림자 없이 여백과 1px 경계선으로만 층위를 만든다",
      "히어로 배경은 장식이 아니라 이 페이지가 다루는 주제(Host ↔ Remote 연합 구조) 자체를 그린다"
    ],
    "primary_tasks": [
      "히어로에서 대표 성과 수치 네 건을 즉시 확인한다",
      "케이스마다 문제 · 접근 · 결과 순서로 읽고 판단 근거를 본다",
      "'자세히'를 펼쳐 구조도와 규명 과정, 철회 기록까지 확인한다",
      "인쇄해 같은 내용을 라이트 팔레트 PDF 이력서로 받는다",
      "연락처에서 GitHub과 이메일로 이동한다"
    ],
    "principles": [
      "주장보다 측정값을 앞세운다. 수치가 없으면 강조하지 않는다",
      "채택한 조치만큼 철회한 조치도 기록한다",
      "도구의 오탐과 자신의 진단 오류까지 실측으로 정정한 과정을 남긴다",
      "화면과 인쇄는 같은 문서다. 섹션을 추가하면 인쇄 규칙도 같이 갱신한다"
    ],
    "summary": "측정으로 검증한 프론트엔드 플랫폼 엔지니어링 이력을, 채용 담당자와 엔지니어링 리더가 스크롤 한 번으로 판정할 수 있게 제시하는 단일 페이지."
  },
  "foundations": {
    "contrast_pairs": [
      {
        "background": "color.bg",
        "foreground": "color.text",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.bg",
        "foreground": "color.muted",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.bg",
        "foreground": "color.faint",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.bg",
        "foreground": "color.accent",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.surface",
        "foreground": "color.muted",
        "minimum_ratio": 4.5
      }
    ],
    "reduced_motion": true,
    "rules": [
      "악센트(color.accent)는 측정값, 링크, hover, focus-visible, 다이어그램 내부 데이터 신호에만 쓴다. 장식 라벨에는 쓰지 않는다",
      "층위는 color.surface와 color.line 1px로만 만든다. box-shadow와 text-shadow를 쓰지 않는다",
      "본문에서 물러난 텍스트는 color.muted, 라벨은 color.faint를 쓴다",
      "인쇄에서는 :root를 라이트 팔레트로 교체하고 악센트를 #a15c00으로 낮춘다"
    ],
    "tokens": {
      "color.accent": {
        "$description": "단 하나의 악센트. 측정값과 상호작용 상태에만 쓴다",
        "$type": "color",
        "$value": "#f0a742"
      },
      "color.accent-dim": {
        "$description": "앰버의 저채도 배경 변형",
        "$type": "color-alpha",
        "$value": "rgba(240, 167, 66, 0.14)"
      },
      "color.bg": {
        "$description": "페이지 바탕. 순검정이 아닌 미세한 청색 기운의 니어블랙",
        "$type": "color",
        "$value": "#0e1116"
      },
      "color.faint": {
        "$description": "섹션 라벨, eyebrow, dt 라벨, 캡션. 앰버에서 물러난 자리를 이 색이 받는다",
        "$type": "color",
        "$value": "#7c8593"
      },
      "color.line": {
        "$description": "섹션 구분선과 컴포넌트 테두리. 층위는 이 1px 선이 만든다",
        "$type": "color",
        "$value": "#242c37"
      },
      "color.muted": {
        "$description": "부연 설명, 자세히 요약, 칩 라벨",
        "$type": "color",
        "$value": "#97a1ad"
      },
      "color.surface": {
        "$description": "칩·코드 블록 등 바탕에서 한 단 올라온 면",
        "$type": "color",
        "$value": "#151a21"
      },
      "color.text": {
        "$description": "본문과 제목의 기본 글자색",
        "$type": "color",
        "$value": "#e9edf2"
      },
      "font.body": {
        "$description": "한글 본문과 제목",
        "$type": "fontFamily",
        "$value": "\"Noto Sans KR\", \"Inter\", -apple-system, \"Apple SD Gothic Neo\", sans-serif"
      },
      "font.mono": {
        "$description": "수치, 영문 라벨, 칩, 코드",
        "$type": "fontFamily",
        "$value": "\"Space Grotesk\", ui-monospace, \"SF Mono\", monospace"
      },
      "layout.case-columns": {
        "$description": "케이스 2단 그리드. 좌측은 라벨과 대표 수치",
        "$type": "dimension",
        "$value": "232px 1fr"
      },
      "layout.case-gap": {
        "$description": "케이스 2단 사이 간격",
        "$type": "dimension",
        "$value": "56px"
      },
      "layout.gutter": {
        "$description": "컨테이너 좌우 여백",
        "$type": "dimension",
        "$value": "28px"
      },
      "layout.max-width": {
        "$description": "본문 컨테이너 최대 폭",
        "$type": "dimension",
        "$value": "1100px"
      },
      "layout.section-gap": {
        "$description": "케이스 섹션 상하 패딩",
        "$type": "dimension",
        "$value": "88px"
      },
      "radius.block": {
        "$description": "코드 블록",
        "$type": "dimension",
        "$value": "4px"
      },
      "radius.chip": {
        "$description": "태그 칩과 케이스 링크",
        "$type": "dimension",
        "$value": "3px"
      },
      "radius.focus": {
        "$description": "포커스 링 모서리",
        "$type": "dimension",
        "$value": "2px"
      }
    }
  },
  "governance": {
    "change_policy": [
      "원본은 포트폴리오/오태훈-포트폴리오.html이며 site/index.html은 재조립 산출물이다. 산출물을 직접 고치지 않는다",
      "타이포·간격·색을 바꾸면 @media print 규칙에 미치는 영향을 함께 확인한다",
      "새 섹션이나 컴포넌트를 추가하면 이 문서의 components_states와 layout_platforms를 같이 갱신한다"
    ],
    "decisions": [
      {
        "evidence": [
          "소유자가 refero.design 레퍼런스 6건을 제시하고 이 방향의 적용을 지시했다",
          "h1 700 -> 400, h2 700 -> 400으로 반영(커밋 d7ca19e, daa80d4)"
        ],
        "path": "/experience/design_direction/1",
        "source_class": "prompt-fact",
        "value": "위계는 크기가 만든다. 굵기로 소리치지 않는다"
      },
      {
        "evidence": [
          "소유자가 앰버 배급 축소를 승인했다",
          "var(--accent) 참조 24 -> 19, 표면 장식 8곳 -> 1곳(커밋 d7ca19e)"
        ],
        "path": "/experience/design_direction/2",
        "source_class": "prompt-fact",
        "value": "앰버는 측정값과 상호작용 상태에만 배급한다"
      },
      {
        "evidence": [
          "포트폴리오/오태훈-포트폴리오.html의 :root 선언에서 직접 추출했다"
        ],
        "path": "/foundations/tokens",
        "source_class": "repository-fact"
      },
      {
        "evidence": [
          "h1, h2, body, .m, .metric .num, .case-stat-num, .eyebrow, dt, details summary, .tags span 규칙과 @media print 재선언에서 추출했다"
        ],
        "path": "/typography_assets/roles",
        "source_class": "repository-fact"
      },
      {
        "evidence": [
          "소스에서 box-shadow 0건, text-shadow 0건을 확인했다"
        ],
        "path": "/foundations/rules/1",
        "source_class": "repository-fact",
        "value": "층위는 color.surface와 color.line 1px로만 만든다. box-shadow와 text-shadow를 쓰지 않는다"
      },
